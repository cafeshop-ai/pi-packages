{
  "name": "@cafecodework/pi-cafe-space",
  "version": "0.1.0",
  "private": true,
  "description": "Share live Pi CLI sessions with authenticated Web/PWA clients without terminal mirroring.",
  "license": "MIT",
  "author": "cafecodework",
  "type": "module",
  "files": [
    "dist",
    "scripts",
    ".env.example",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/refactor/pack.mjs",
    "prepack": "node scripts/prepack.mjs",
    "start": "node scripts/run-built.mjs",
    "legacy:build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('web/public','dist/relay/public',{recursive:true})\"",
    "legacy:relay": "node dist/relay/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "refactor:contracts:test": "vitest run src/protocol/fixtures.test.ts",
    "refactor:web:check": "tsc -p web/tsconfig.json --noEmit",
    "refactor:web:test": "vitest run --config web/vitest.config.ts",
    "refactor:web:build": "vite build --config web/vite.config.ts",
    "refactor:assets:test": "node --test scripts/refactor/assets.test.mjs scripts/refactor/hash-router-only.test.mjs",
    "refactor:relay:build": "node scripts/refactor/build.mjs",
    "refactor:release": "node scripts/refactor/release.mjs",
    "refactor:pack": "node scripts/refactor/pack.mjs",
    "remote:pack": "node scripts/refactor/pack.mjs",
    "remote:setup": "node scripts/remote/setup.mjs",
    "remote:run": "node scripts/remote/run.mjs",
    "room:setup": "node scripts/remote/room-setup.mjs",
    "room:run": "node scripts/remote/room-run.mjs",
    "room:install": "node scripts/remote/install-client.mjs",
    "room:server": "node scripts/remote/configure-server.mjs",
    "room:doctor": "node scripts/remote/doctor.mjs",
    "room:bootstrap": "node scripts/remote/room-bootstrap.mjs",
    "room:install:test": "node --test scripts/remote/install-tools.test.mjs scripts/remote/room-setup.test.mjs",
    "remote:test": "node --test scripts/remote/setup.test.mjs scripts/refactor/matrix.test.mjs",
    "refactor:build:test": "node --test --test-concurrency=1 scripts/refactor/candidate.test.mjs scripts/refactor/source-build.test.mjs",
    "refactor:launcher:test": "node --test scripts/refactor/launcher.test.mjs",
    "refactor:integration:test": "node scripts/refactor/integration.mjs",
    "relay": "node scripts/run-built.mjs",
    "relay:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-relay.ps1",
    "relay:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-relay.ps1",
    "pi:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pi.ps1"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "@base-ui/react": "1.8.0",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "25.8.13",
    "immer": "11.1.4",
    "lodash-es": "4.18.1",
    "lucide-react": "1.48.0",
    "modern-normalize": "3.0.1",
    "nanoid": "5.1.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.5.4",
    "react-router": "7.18.2",
    "tailwind-merge": "3.7.0",
    "use-immer": "0.11.0",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/lodash-es": "4.17.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "playwright-core": "1.63.0",
    "postcss": "8.5.26",
    "qrcode-generator": "2.0.4",
    "qrcode.react": "4.2.0",
    "sass": "1.97.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
