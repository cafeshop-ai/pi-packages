# Local relay defaults
PI_COLLAB_HOST=127.0.0.1
PI_COLLAB_PORT=37891
PI_COLLAB_HOST_TOKEN=replace-with-a-long-random-host-token
PI_COLLAB_CLIENT_TOKEN=replace-with-a-long-random-client-token
# Comma-separated http(s) browser origins (no path/query/fragment); an empty list also permits non-browser no-Origin connections.
PI_COLLAB_ALLOWED_ORIGINS=
# Optional stable identity for one Pi runtime; leave empty for an automatic random ID.
# PI_COLLAB_PEER_ID=
